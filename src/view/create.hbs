<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title mb-0">Tạo bài viết mới</h3>
                </div>
                <div class="card-body">
                    <!-- Form gửi dữ liệu qua phương thức POST về /blogs/store -->
                    <form action="/blogs/store" method="POST">
                        
                        <!-- Tiêu đề bài viết -->
                        <div class="form-group mb-3">
                            <label for="title" class="font-weight-bold">Tiêu đề bài viết:</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="title" 
                                name="title" 
                                placeholder="Tiêu đề..." 
                                required
                            >
                        </div>

                        <!-- Danh mục bài viết (ĐÃ BỔ SUNG) -->
                        <div class="form-group mb-3">
                            <label for="category" class="font-weight-bold">Danh mục bài viết:</label>
                            <select class="form-control" id="category" name="category">
                                <option value="Lập trình">Lập trình</option>
                                <option value="Sở thích">Sở thích</option>
                                <option value="Tính cách">Tính cách</option>
                                <option value="Ẩm thực">Ẩm thực</option>
                                <option value="Học tập">Học tập</option>
                                <option value="Định hướng">Định hướng</option>
                                <option value="Khác">Khác</option>
                            </select>
                        </div>

                        <!-- Mô tả ngắn -->
                        <div class="form-group mb-3">
                            <label for="description" class="font-weight-bold">Mô tả ngắn:</label>
                            <textarea 
                                class="form-control" 
                                id="description" 
                                name="description" 
                                rows="3" 
                                placeholder="Mô tả..."
                            ></textarea>
                        </div>

                        <!-- Đường dẫn hình ảnh -->
                        <div class="form-group mb-3">
                            <label for="image" class="font-weight-bold">Đường dẫn ảnh (URL):</label>
                            <input 
                                type="text" 
                                class="form-control" 
                                id="image" 
                                name="img" 
                                placeholder="https://example.com/image.jpg"
                            >
                        </div>

                        <!-- Nội dung chi tiết -->
                        <div class="form-group mb-4">
                            <label for="content" class="font-weight-bold">Nội dung chi tiết:</label>
                            <textarea 
                                class="form-control" 
                                id="content" 
                                name="content" 
                                rows="6" 
                                placeholder="Nội dung..." 
                                required
                            ></textarea>
                        </div>

                        <!-- Nút gửi form -->
                        <div class="d-flex justify-content-end">
                            <a href="/" class="btn btn-secondary mr-2 me-2">Hủy bỏ</a>
                            <button type="submit" class="btn btn-success">Đăng bài</button>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>