<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>SimpleBlog</title>
    <!-- 1. Bootstrap 4 CSS CDN -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/css/bootstrap.min.css">
    
    <!-- 2. Font Awesome 6 CDN (Hiển thị Icon) -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <!-- 3. CSS riêng của dự án -->
    <link rel="stylesheet" href="/css/app.css">

    <!-- 4. CSS Tùy chỉnh Dark Mode cho Form & Input -->
    <style>
        body {
            background-color: #121212 !important;
            color: #e0e0e0 !important;
        }
        .form-control, .custom-select, .form-control:focus {
            background-color: #2b3035 !important;
            color: #ffffff !important;
            border-color: #495057 !important;
        }
        .form-control::placeholder {
            color: #a0a0a0 !important;
        }
        .card {
            background-color: #1e1e1e !important;
            color: #ffffff !important;
            border-color: #333333 !important;
        }
    </style>
</head>
<body class="bg-dark text-white">

    <!-- Header Partials -->
    {{> header}}

    <!-- Nội dung thay đổi từng trang -->
    <div class="container my-4">
        {{{body}}}
    </div>

    <!-- Footer Partials -->
    {{> footer}}

    <!-- 5. Thư viện JS của Bootstrap 4 -->
    <script src="https://code.jquery.com/jquery-3.5.1.slim.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.min.js"></script>
</body>
</html>