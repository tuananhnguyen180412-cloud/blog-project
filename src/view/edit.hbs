<div class="container mt-4">
    <h3>Cập nhật bài viết</h3>

    <form method="POST" action="/blogs/{{blog._id}}?_method=PUT" class="mt-4">
        <div class="mb-3">
            <label for="title" class="form-label">Tên bài viết</label>
            <input type="text" class="form-control" value="{{blog.title}}" id="title" name="title" required>
        </div>
        
        <div class="mb-3">
            <label for="description" class="form-label">Mô tả ngắn</label>
            <textarea class="form-control" id="description" name="description" rows="3">{{blog.description}}</textarea>
        </div>

        <button type="submit" class="btn btn-primary">Lưu thay đổi</button>
        <a href="/me/stored/blogs" class="btn btn-secondary">Hủy</a>
    </form>
</div>