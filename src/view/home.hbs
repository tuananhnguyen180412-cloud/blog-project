<main>
    <!-- HERO SECTION / BANNER -->
    <div class="jumbotron jumbotron-fluid bg-dark text-white rounded-lg shadow-sm py-5 px-4 mb-5" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="row align-items-center">
            <div class="col-md-7 mb-4 mb-md-0">
                <h1 class="display-4 font-weight-bold mb-2 text-white">
                    Hi, I'm <span class="text-primary">Nguyen Tuan Anh</span>.
                </h1>
                <h2 class="h3 text-light mb-3">Web Developer</h2>
                <p class="lead text-white-50">
                    Specialized in <abbr title="Accessibility" class="text-info">a11y</abbr> and Core Web Vitals
                </p>
                <div class="pt-2">
                    <a href="/contact" class="btn btn-primary mr-2 shadow-sm">Contact Me</a>
                    <a href="/about" class="btn btn-outline-light shadow-sm">About Me</a>
                </div>
            </div>
            <div class="col-md-5 text-center">
                <img src="/img/my-avatar.png" alt="Nguyen Tuan Anh" class="img-fluid rounded-circle border border-secondary shadow" style="width: 220px; height: 220px; object-fit: cover;" onerror="this.onerror=null; this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png';">
            </div>
        </div>
    </div>

    <!-- CATEGORY FILTER BUTTONS -->
    <div class="mb-4">
        <div class="d-flex flex-wrap align-items-center">
            <span class="text-white-50 mr-2 font-weight-bold"><i class="fa-solid fa-filter mr-1"></i> Danh mục:</span>
            {{#each categories}}
                <a href="/?category={{this}}" 
                   class="btn btn-sm {{#if (eq this ../currentCategory)}}btn-primary{{else}}btn-outline-light text-white-50{{/if}} mr-2 mb-2 rounded-pill px-3">
                    {{this}}
                </a>
            {{/each}}
        </div>
    </div>

    <!-- MAIN CONTENT SECTION -->
    <div class="row">
        <!-- LEFT: BLOG POSTS -->
        <div class="col-lg-8">
            <h3 class="h4 font-weight-bold mb-4 border-left border-primary pl-3 text-white">Bài đăng blog mới nhất</h3>
            
            <div class="mb-4" id="blog-list-container">
                {{#each blogs}}
                <div class="card mb-4 border-0 shadow-sm rounded-lg overflow-hidden bg-secondary text-white" style="background-color: #212529 !important;">
                    <div class="row no-gutters">
                        <!-- BỌC LINK CHO HÌNH ẢNH -->
                        <div class="col-md-4 bg-dark">
                            <a href="/blogs/{{#if this.slug}}{{this.slug}}{{else}}{{this._id}}{{/if}}">
                                <img src="{{this.img}}" alt="{{this.title}}" class="w-100 h-100" style="object-fit: cover; min-height: 180px;" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80';">
                            </a>
                        </div>
                        <div class="col-md-8">
                            <div class="card-body d-flex flex-column justify-content-between h-100 py-3">
                                <div>
                                    <span class="badge badge-primary mb-2 p-2">
                                        {{#if this.category}}{{this.category}}{{else}}NodeJS{{/if}}
                                    </span>
                                    
                                    <!-- BỌC LINK CHO TIÊU ĐỀ BÀI VIẾT -->
                                    <h4 class="card-title h5 font-weight-bold">
                                        <a href="/blogs/{{#if this.slug}}{{this.slug}}{{else}}{{this._id}}{{/if}}" class="text-white text-decoration-none">
                                            {{this.title}}
                                        </a>
                                    </h4>
                                    
                                    <p class="card-text text-white-50 small text-truncate">
                                        {{this.content}}
                                    </p>
                                </div>
                                <div class="d-flex align-items-center mt-3 pt-2 border-top border-secondary">
                                    <img src="/img/my-avatar.png" alt="Nguyen Tuan Anh" class="rounded-circle mr-2" width="35" height="35" style="object-fit: cover;" onerror="this.onerror=null; this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png';">
                                    <div class="small">
                                        <a href="#" class="text-white font-weight-bold d-block text-decoration-none">Nguyen Tuan Anh</a>
                                        <span class="text-white-50">
                                            {{dateFormat updatedAt "dddd, DD-MM-YYYY"}}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{/each}}
            </div>

            <!-- NÚT TẢI THÊM -->
            <div class="text-center mb-5">
                <a href="/search" id="load-more-btn" class="btn btn-outline-light px-4 shadow-sm rounded-pill">
                    Tải thêm
                </a>
            </div>
        </div>

        <!-- RIGHT: SIDEBAR -->
        <div class="col-lg-4">
            <!-- TOPICS -->
            <div class="card border-0 shadow-sm rounded-lg mb-4 text-white" style="background-color: #212529;">
                <div class="card-body">
                    <h4 class="h5 font-weight-bold mb-3 text-white">Chủ đề</h4>
                    <div class="list-group list-group-flush">
                        <a href="/search?topic=database" class="list-group-item list-group-item-action d-flex align-items-center border-0 px-0 bg-transparent text-white">
                            <i class="fa-solid fa-database text-primary mr-3"></i>
                            <span>Cơ sở dữ liệu</span>
                        </a>
                        <a href="/search?topic=a11y" class="list-group-item list-group-item-action d-flex align-items-center border-0 px-0 bg-transparent text-white">
                            <i class="fa-solid fa-universal-access text-primary mr-3"></i>
                            <span>Khả năng tiếp cận</span>
                        </a>
                        <a href="/search?topic=webperf" class="list-group-item list-group-item-action d-flex align-items-center border-0 px-0 bg-transparent text-white">
                            <i class="fa-solid fa-rocket text-primary mr-3"></i>
                            <span>Hiệu suất Web</span>
                        </a>
                    </div>
                </div>
            </div>

            <!-- TAGS -->
            <div class="card border-0 shadow-sm rounded-lg mb-4 text-white" style="background-color: #212529;">
                <div class="card-body">
                    <h4 class="h5 font-weight-bold mb-3 text-white">Thẻ</h4>
                    <div class="d-flex flex-wrap" style="gap: 6px;">
                        <a href="/search?tag=mongodb" class="badge badge-dark border border-secondary p-2 text-white-50 text-decoration-none">#mongodb</a>
                        <a href="/search?tag=nodejs" class="badge badge-dark border border-secondary p-2 text-white-50 text-decoration-none">#nodejs</a>
                        <a href="/search?tag=a11y" class="badge badge-dark border border-secondary p-2 text-white-50 text-decoration-none">#a11y</a>
                        <a href="/search?tag=di-chuyen" class="badge badge-dark border border-secondary p-2 text-white-50 text-decoration-none">#di chuyển</a>
                        <a href="/search?tag=bao-gom" class="badge badge-dark border border-secondary p-2 text-white-50 text-decoration-none">#bao gồm</a>
                        <a href="/search?tag=webperf" class="badge badge-dark border border-secondary p-2 text-white-50 text-decoration-none">#webperf</a>
                        <a href="/search?tag=toi-uu-hoa" class="badge badge-dark border border-secondary p-2 text-white-50 text-decoration-none">#tối ưu hóa</a>
                        <a href="/search?tag=hieu-suat" class="badge badge-dark border border-secondary p-2 text-white-50 text-decoration-none">#hiệu suất</a>
                    </div>
                </div>
            </div>

            <!-- CONTACT SOCIAL -->
            <div class="card border-0 shadow-sm rounded-lg mb-4 text-white" style="background-color: #212529;">
                <div class="card-body">
                    <h4 class="h5 font-weight-bold mb-2 text-white">Hãy cùng trò chuyện</h4>
                    <p class="small text-white-50 mb-3">
                        Bạn có muốn tìm hiểu thêm về cách tôi có thể giúp công ty của bạn giải quyết các vấn đề? Hãy cùng trò chuyện.
                    </p>
                    <div>
                        <a href="#" class="btn btn-sm btn-dark text-primary mr-1 border-secondary"><i class="fa-brands fa-discord"></i></a>
                        <a href="#" class="btn btn-sm btn-dark text-info mr-1 border-secondary"><i class="fa-brands fa-twitter"></i></a>
                        <a href="#" class="btn btn-sm btn-dark text-primary border-secondary"><i class="fa-brands fa-facebook"></i></a>
                    </div>
                </div>
            </div>

            <!-- NEWSLETTER -->
            <div class="card border-0 shadow-sm rounded-lg mb-4 text-white" style="background-color: #212529;">
                <div class="card-body">
                    <h4 class="h5 font-weight-bold mb-2 text-white">Bản tin</h4>
                    <p class="small text-white-50 mb-3">
                        Đăng ký nhận bản tin của chúng tôi để trở thành một trong những người đầu tiên cập nhật những thông tin mới nhất.
                    </p>
                    <form action="#">
                        <div class="form-group mb-2">
                            <input type="email" name="email" class="form-control form-control-sm bg-dark text-white border-secondary" placeholder="Địa chỉ Email" required>
                        </div>
                        <button type="submit" class="btn btn-primary btn-block btn-sm">Đăng ký</button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</main>