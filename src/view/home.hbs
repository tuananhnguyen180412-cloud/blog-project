<main>
    <!-- HERO SECTION / BANNER -->
    <div class="jumbotron jumbotron-fluid bg-dark text-white rounded-lg shadow-sm py-5 px-4 mb-5" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
        <div class="row align-items-center">
            <div class="col-md-7 mb-4 mb-md-0">
                <h1 class="display-4 font-weight-bold mb-2 text-white">
                    Chào mừng đến website cá nhân của <span class="text-primary">Nguyễn Tuấn Anh</span>.
                </h1>
                <h2 class="h3 text-light mb-3"Code & Design Enthusiast</h2>
                <p class="lead text-white-50">
                <div class="pt-2">
                    <a href="/contact" class="btn btn-primary mr-2 shadow-sm">Contact Me</a>
                    <a href="/about" class="btn btn-outline-light shadow-sm">About Me</a>
                </div>
            </div>
            <div class="col-md-5 text-center">
                <img src="/img/my-avatar.png" alt="Nguyen Tuan Anh" class="img-fluid rounded-circle border border-secondary shadow" style="width: 220px; height: 220px; object-fit: cover;" onerror="this.onerror=null; this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png';">
            </div>
        </div>
    </div>

    <!-- CATEGORY FILTER SELECT -->
    <div class="mb-4">
        <div class="form-inline">
            <label for="categorySelect" class="text-white-50 mr-2 font-weight-bold mb-0">
                <i class="fa-solid fa-filter mr-1"></i> Danh mục:
            </label>
            <select id="categorySelect" class="form-control form-control-sm bg-dark text-white border-secondary rounded-pill px-3" style="max-width: 220px; cursor: pointer;" onchange="if (this.value) window.location.href = this.value;">
                <option value="/">Tất cả</option>
                {{#each categories}}
                    <option value="/?category={{this}}">{{this}}</option>
                {{/each}}
            </select>
        </div>
    </div>

    <!-- MAIN CONTENT SECTION -->
    <div class="row">
        <!-- LEFT: BLOG POSTS -->
        <div class="col-lg-8">
            <h3 class="h4 font-weight-bold mb-4 border-left border-primary pl-3 text-white">
                {{#if currentCategory}}
                    Bài viết thuộc danh mục: <span class="text-primary">{{currentCategory}}</span>
                {{else}}
                    Bài đăng blog mới nhất
                {{/if}}
            </h3>
            
            <div class="mb-4" id="blog-list-container">
                {{#each blogs}}
                <div class="card mb-4 border-0 shadow-sm rounded-lg overflow-hidden text-white" style="background-color: #212529 !important;">
                    <div class="row no-gutters">
                        <div class="col-md-4 bg-dark">
                            <a href="/blogs/{{this._id}}">
                                <img src="{{this.img}}" alt="{{this.title}}" class="w-100 h-100" style="object-fit: cover; min-height: 180px;" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80';">
                            </a>
                        </div>
                        <div class="col-md-8">
                            <div class="card-body d-flex flex-column justify-content-between h-100 py-3">
                                <div>
                                    <span class="badge badge-primary mb-2 p-2">
                                        {{this.category}}
                                    </span>
                                    
                                    <h4 class="card-title h5 font-weight-bold">
                                        <a href="/blogs/{{this._id}}" class="text-white text-decoration-none">
                                            {{this.title}}
                                        </a>
                                    </h4>
                                    
                                    <p class="card-text text-white-50 small text-truncate">
                                        {{this.content}}
                                    </p>
                                </div>
                                <div class="d-flex align-items-center mt-3 pt-2 border-top border-secondary">
                                    <img src="/img/my-avatar.png" alt="Nguyen Tuan Anh" class="rounded-circle mr-2" width="35" height="35" style="object-fit: cover;" onerror="this.onerror=null; this.src='https://cdn-icons-png.flaticon.com/512/149/149071.png';">
                                    <div class="small">
                                        <a href="#" class="text-white font-weight-bold d-block text-decoration-none">Nguyen Tuan Anh</a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                {{else}}
                <div class="alert alert-dark text-white-50 text-center py-4 rounded-lg border border-secondary" role="alert">
                    Chưa có bài viết nào thuộc danh mục này.
                </div>
                {{/each}}
            </div>

            <!-- NÚT THÊM BÀI VIẾT (ĐÃ THAY CHO NÚT TẢI THÊM) -->
            <div class="text-center mb-5">
                <a href="/blogs/create" class="btn btn-primary px-4 shadow-sm rounded-pill font-weight-bold">
                    <i class="fa-solid fa-plus mr-1"></i> Thêm bài viết
                </a>
            </div>
        </div>

        <!-- RIGHT: SIDEBAR -->
        <div class="col-lg-4">
            <!-- WIDGET THỐNG KÊ SỐ BÀI VIẾT -->
            <div class="card border-0 shadow-sm rounded-lg mb-4 text-white" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); border: 1px solid #334155 !important;">
                <div class="card-body text-center py-4">
                    <div class="d-inline-block p-3 rounded-circle bg-primary text-white mb-2 shadow-sm">
                        <i class="fa-solid fa-file-lines fa-2x"></i>
                    </div>
                    <h4 class="display-4 font-weight-bold mb-0 text-white">{{blogs.length}}</h4>
                    <p class="text-white-50 mb-0 font-weight-bold text-uppercase small" style="letter-spacing: 1px;">Bài viết khả dụng</p>
                </div>
            </div>

            <!-- TOPICS -->
            <div class="card border-0 shadow-sm rounded-lg mb-4 text-white" style="background-color: #212529;">
                <div class="card-body">
                    <h4 class="h5 font-weight-bold mb-3 text-white">Chủ đề</h4>
                    <div class="list-group list-group-flush">
                        <a href="/search?topic=database" class="list-group-item list-group-item-action d-flex align-items-center border-0 px-0 bg-transparent text-white">
                            <i class="fa-solid fa-database text-primary mr-3"></i>
                            <span>Cơ sở dữ liệu</span>
                        </a>
                        <a href="/search?topic=a11y" class="list-group-item list-group-item-action d-flex align-items-center border-0 px-0 bg-transparent text-white">
                            <i class="fa-solid fa-universal-access text-primary mr-3"></i>
                            <span>Khả năng tiếp cận</span>
                        </a>
                        <a href="/search?topic=webperf" class="list-group-item list-group-item-action d-flex align-items-center border-0 px-0 bg-transparent text-white">
                            <i class="fa-solid fa-rocket text-primary mr-3"></i>
                            <span>Hiệu suất Web</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- SCRIPT ĐỒNG BỘ TRẠNG THÁI CHO SELECT KHI TẢI TRANG -->
<script>
    (function syncCategorySelect() {
        var select = document.getElementById('categorySelect');
        if (!select) return;

        var urlParams = new URLSearchParams(window.location.search);
        var currentCat = urlParams.get('category');

        if (currentCat) {
            var targetValue = '/?category=' + currentCat;
            for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].value === targetValue) {
                    select.selectedIndex = i;
                    break;
                }
            }
        } else {
            select.selectedIndex = 0;
        }
    })();
</script>