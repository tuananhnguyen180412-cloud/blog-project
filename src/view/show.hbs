<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <!-- Nút quay lại -->
            <a href="/" class="btn btn-outline-secondary mb-4">
                &larr; Quay lại trang chủ
            </a>

            <!-- Tiêu đề bài viết -->
            <h1 class="fw-bold mb-3">{{blog.title}}</h1>

            <!-- Ngày tạo bài viết -->
            <div class="text-muted mb-4 fs-6">
                <span>Đăng ngày: {{blog.createdAt}}</span>
            </div>

            <!-- Hình ảnh bài viết (nếu có) -->
            {{#if blog.image}}
                <div class="text-center mb-4">
                    <img src="{{blog.image}}" class="img-fluid rounded shadow-sm w-100" style="max-height: 450px; object-fit: cover;" alt="{{blog.title}}">
                </div>
            {{/if}}

            <!-- Nội dung bài viết -->
            <div class="blog-content fs-5 leading-relaxed text-justify mt-4">
                <p style="white-space: pre-line;">{{blog.content}}</p>
            </div>

            <hr class="my-5">

            <!-- Thao tác phụ (Chỉnh sửa / Quay lại) -->
            <div class="d-flex justify-content-between align-items-center">
                <a href="/" class="btn btn-secondary">Xem tất cả bài viết</a>
            </div>
        </div>
    </div>
</div>