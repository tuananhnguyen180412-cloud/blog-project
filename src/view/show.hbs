<div class="container mt-5 mb-5 text-white">
    <div class="row justify-content-center">
        <div class="col-md-9">
            <!-- Nút quay lại -->
            <a href="/" class="btn btn-outline-light mb-4 shadow-sm">
                &larr; Quay lại trang chủ
            </a>

            <!-- Tiêu đề bài viết -->
            <h1 class="fw-bold mb-3 text-white">{{blog.title}}</h1>

            <!-- Ngày tạo bài viết (Đã dùng helper dateFormat) -->
            <div class="text-white-50 mb-4 fs-6">
                <span>Đăng ngày: {{dateFormat blog.createdAt "dddd, DD-MM-YYYY"}}</span>
            </div>

            <!-- Hình ảnh bài viết (Đã sửa từ blog.image -> blog.img) -->
            {{#if blog.img}}
                <div class="text-center mb-4">
                    <img src="{{blog.img}}" class="img-fluid rounded shadow-sm w-100" style="max-height: 450px; object-fit: cover;" alt="{{blog.title}}" onerror="this.onerror=null; this.src='https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=600&auto=format&fit=crop&q=80';">
                </div>
            {{/if}}

            <!-- Nội dung bài viết -->
            <div class="blog-content fs-5 leading-relaxed text-justify mt-4">
                <p style="white-space: pre-line;" class="text-light">{{blog.content}}</p>
            </div>

            <hr class="my-5 border-secondary">

            <!-- Thao tác phụ (Chỉnh sửa / Quay lại) -->
            <div class="d-flex justify-content-between align-items-center">
                <a href="/" class="btn btn-secondary shadow-sm">Xem tất cả bài viết</a>
                <a href="/blogs/{{blog._id}}/edit" class="btn btn-warning shadow-sm">Chỉnh sửa bài viết</a>
            </div>
        </div>
    </div>
</div>