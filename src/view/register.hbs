<div class="container mt-5 mb-5">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-header bg-success text-white text-center">
                    <h4 class="mb-0">Đăng Ký Tài Khoản</h4>
                </div>
                <div class="card-body">
                    <form action="/register" method="POST">
                        <div class="form-group mb-3">
                            <label for="fullname" class="font-weight-bold">Họ và tên:</label>
                            <input type="text" class="form-control" id="fullname" name="fullname" placeholder="Nhập họ tên..." required>
                        </div>
                        <div class="form-group mb-3">
                            <label for="email" class="font-weight-bold">Email:</label>
                            <input type="email" class="form-control" id="email" name="email" placeholder="Nhập email..." required>
                        </div>
                        <div class="form-group mb-3">
                            <label for="password" class="font-weight-bold">Mật khẩu:</label>
                            <input type="password" class="form-control" id="password" name="password" placeholder="Nhập mật khẩu..." required>
                        </div>
                        <button type="submit" class="btn btn-success btn-block w-100">Đăng ký</button>
                    </form>
                    <div class="text-center mt-3">
                        <small>Đã có tài khoản? <a href="/login">Đăng nhập</a></small>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>